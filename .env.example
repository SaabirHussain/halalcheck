DATABASE_URL=postgres://postgres:postgres@localhost:5432/halalcheck
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/halalcheck_test
APP_URL=http://localhost:3000
DEMO_MODE=true
QUEUE_DRIVER=pg-boss
PLACES_PROVIDER=demo
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_SEARCH_DAILY_LIMIT=150
GOOGLE_PLACES_DETAILS_DAILY_LIMIT=150
DISCOVERY_DEFAULT_CENTER=43.6532,-79.3832
GEOCODER_PROVIDER=demo
NOMINATIM_USER_AGENT=HalalCheck/0.1 (local development)
AI_PROVIDER=demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Supported providers: demo, mailgun, resend
EMAIL_PROVIDER=demo
PUSH_PROVIDER=demo
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE=https://api.resend.com
CAP_SERVER_URL=http://10.0.2.2:3000
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_API_BASE=https://api.mailgun.net/v3
OUTREACH_ALLOW_REAL_SEND=false
OUTREACH_FROM_ADDRESS=research@demo.halalcheck.test
OUTREACH_REPLY_DOMAIN=demo.halalcheck.test
OUTREACH_DEFAULT_TIMEZONE=America/Toronto
OUTREACH_BUSINESS_HOURS=09:00-17:00
OUTREACH_BUSINESS_DAYS=1-5
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
REFRESH_AFTER_DAYS=180
CERT_EXPIRY_WARNING_DAYS=30

# Railway production (set these in the service variables)
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# APP_URL=https://your-app.up.railway.app
# DEMO_MODE=false
# STORAGE_DIR=/data/storage
# PLACES_PROVIDER=<approved-provider>
# GOOGLE_PLACES_API_KEY=<server-side-places-key>
# GOOGLE_PLACES_SEARCH_DAILY_LIMIT=150
# GOOGLE_PLACES_DETAILS_DAILY_LIMIT=150
# DISCOVERY_DEFAULT_CENTER=43.6532,-79.3832
# GEOCODER_PROVIDER=<approved-provider>
# AI_PROVIDER=<approved-provider>
# EMAIL_PROVIDER=demo
# PUSH_PROVIDER=demo
# OUTREACH_ALLOW_REAL_SEND=false
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<set-only-when-running-admin-create>
# ADMIN_NAME=HalalCheck Administrator
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<http-referrer-restricted-browser-key>
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
